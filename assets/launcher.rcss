body {
    width: 100%;
    height: 100%;
    background-color: #101619;
    color: #eff5f0;
    font-family: LatoLatin;
    font-size: 15dp;
}

.shell { display: flex; width: 100%; height: 100%; }
.sidebar {
    position: relative;
    box-sizing: border-box;
    width: 222dp;
    flex: none;
    padding: 28dp 14dp;
    background-color: #131c1f;
    border-right: 1dp #2b3738;
}
.brand {
    display: flex;
    align-items: center;
    margin: 0 8dp 40dp;
    font-size: 24dp;
    font-weight: bold;
    line-height: 1.05;
}
.brand-mark {
    display: block;
    box-sizing: border-box;
    width: 43dp;
    height: 43dp;
    line-height: 43dp;
    margin-right: 12dp;
    text-align: center;
    border-radius: 10dp;
    color: #182420;
    background-color: #b8ed8e;
}
small { display: block; margin-top: 5dp; color: #aabbb4; font-size: 10dp; }
.nav-label { margin: 0 10dp 12dp; color: #9badab; font-size: 11dp; font-weight: bold; }
button {
    box-sizing: border-box;
    font-size: 15dp;
    color: #eff5f0;
    cursor: pointer;
    border: 1dp #405550;
    border-radius: 7dp;
    background-color: #263532;
    tab-index: auto;
}
button:hover, button:focus-visible { border-color: #b8ed8e; background-color: #34483b; }
button:disabled { cursor: default; opacity: 0.55; }
.nav {
    display: block;
    width: 100%;
    height: 45dp;
    margin-bottom: 5dp;
    padding: 0 10dp;
    text-align: left;
    line-height: 43dp;
    color: #c3d2cd;
    border-color: transparent;
    background-color: transparent;
}
.nav.active { color: #c7f6a3; background-color: #293c32; border-color: #3d5746; font-weight: bold; }
.sidebar-footer { position: absolute; bottom: 25dp; left: 23dp; color: #b5c4bf; font-size: 12dp; }
.preview-dot { display: inline-block; width: 7dp; height: 7dp; margin-right: 7dp; border-radius: 4dp; background-color: #b8ed8e; }

.main { display: flex; flex: 1 auto; min-width: 0; flex-direction: column; }
.topbar { flex: none; padding: 19dp 31dp; color: #e1eae3; background-color: #141d20; border-bottom: 1dp #2b3738; font-size: 13dp; }
.topbar-brand { color: #9badab; font-size: 11dp; font-weight: bold; }
.slash { margin: 0 9dp; color: #80978d; }
.page {
    display: block;
    box-sizing: border-box;
    flex: 1 auto;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 24dp 31dp;
}
.hidden { display: none; }

/* RmlUi needs an explicit width for its vertical scrollbar. */
scrollbarvertical { width: 9dp; background-color: #182222; }
scrollbarvertical sliderbar { min-height: 24dp; border-radius: 4dp; background-color: #526b62; }
scrollbarvertical sliderbar:hover { background-color: #779386; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { display: none; }

.hero, .hero-content, .eyebrow, h1, h2, p, .page-heading, .item-name, .item-copy > .muted {
    display: block;
}
.hero {
    min-height: 217dp;
    border: 1dp #3b5548;
    border-radius: 12dp;
    background-color: #172922;
    decorator: image(terrain.tga cover) border-box;
}
.hero-content { padding: 36dp 28dp; }
.eyebrow { color: #b8ed8e; font-size: 11dp; font-weight: bold; }
h1 { margin: 6dp 0 8dp; font-size: 43dp; font-weight: bold; line-height: 1.12; }
h2 { margin: 0; font-size: 22dp; font-weight: bold; }
p { margin: 0; color: #baccc3; line-height: 1.4; }
.hero p { max-width: 260dp; }
.page-heading { margin: 5dp 0 25dp; }
.launch-panel, .toolbar {
    display: flex;
    align-items: flex-end;
    gap: 13dp;
    margin: 15dp 0 22dp;
    padding: 13dp 15dp;
    border: 1dp #2c3d3b;
    border-radius: 9dp;
    background-color: #192524;
}
.launch-pick, .grow { flex: 1 auto; min-width: 0; }
.field.filter { width: 155dp; }
.field.target { width: 222dp; }
label { display: block; margin-bottom: 6dp; color: #aebfb7; font-size: 10dp; font-weight: bold; }
select, input.text {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 40dp;
    color: #eff5f0;
    background-color: #111b1c;
    border: 1dp #415652;
    border-radius: 6dp;
    font-size: 15dp;
}
input.text { padding: 9dp 10dp; }
input.text:focus, select:focus { border-color: #b8ed8e; }
selectvalue { display: block; padding: 8dp 29dp 8dp 10dp; }
selectarrow { display: block; width: 9dp; height: 9dp; margin: 12dp 12dp 0 0; border-right: 2dp #b8ed8e; border-bottom: 2dp #b8ed8e; transform: rotate(45deg); }
selectbox { display: block; background-color: #1a2927; color: #eff5f0; border: 1dp #526b62; }
option { display: block; padding: 8dp 10dp; }
option:hover, option:checked { background-color: #334d39; }
.primary { padding: 0 16dp; height: 40dp; line-height: 38dp; font-weight: bold; color: #17231c; border-color: #b8ed8e; background-color: #b8ed8e; }
.primary:hover, .primary:focus-visible { background-color: #d0f9b0; }
.launch { min-width: 156dp; }
.section-heading { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12dp; }
.muted { color: #aabcaf; font-size: 12dp; }
.list { display: flex; flex-direction: column; gap: 7dp; }
.row {
    display: flex;
    box-sizing: border-box;
    align-items: center;
    gap: 12dp;
    min-height: 60dp;
    padding: 8dp 12dp;
    background-color: #182222;
    border: 1dp #2c3d3b;
    border-radius: 8dp;
}
.row.selected { border-color: #6c955f; }
.tile {
    flex: none;
    box-sizing: border-box;
    width: 36dp;
    height: 36dp;
    line-height: 35dp;
    text-align: center;
    color: #c8ef9e;
    background-color: #293c31;
    border: 1dp #46624c;
    border-radius: 7dp;
    font-weight: bold;
}
.tile.game { color: #aed8f9; background-color: #243642; border-color: #3d596b; }
.tile.mod { color: #e0c4f8; background-color: #382c43; border-color: #594463; }
.item-copy { flex: 1 auto; min-width: 0; }
.item-name { margin-bottom: 3dp; font-weight: bold; }
.row-action { min-width: 94dp; min-height: 32dp; padding: 3dp 9dp; font-size: 13dp; }
.empty { padding: 20dp 14dp; color: #adbfba; background-color: #182222; border: 1dp #2c3d3b; border-radius: 8dp; }
.status {
    flex: none;
    min-height: 20dp;
    padding: 10dp 31dp;
    border-top: 1dp #2b3738;
    background-color: #141d20;
    color: #aabcaf;
    font-size: 13dp;
}
.status.notice { color: #f3d18f; }
.status.accepted { color: #c7f6a3; }

@media (max-width: 820dp) {
    .sidebar { width: 174dp; }
    .page { padding: 20dp; }
    .topbar, .status { padding-left: 20dp; padding-right: 20dp; }
    .hero-content { padding-left: 19dp; }
    h1 { font-size: 37dp; }
}
@media (max-width: 630dp) {
    .sidebar { width: 131dp; padding: 23dp 6dp; }
    .brand { font-size: 18dp; margin: 0 4dp 30dp; }
    .brand-mark { width: 30dp; height: 33dp; line-height: 33dp; margin-right: 6dp; }
    .nav { font-size: 12dp; padding: 0 5dp; }
    .sidebar-footer { left: 11dp; }
    .page { padding: 12dp; }
    .toolbar { align-items: stretch; flex-direction: column; }
    .field.filter, .field.target { width: auto; }
    .launch { min-width: 94dp; }
    h1 { font-size: 30dp; }
}
