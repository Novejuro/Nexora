{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure Release",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: build Release",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Release",
                "--parallel"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: configure Release",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
